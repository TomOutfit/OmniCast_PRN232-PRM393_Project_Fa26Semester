# Local MediaMTX binary / archives (downloaded by scripts/start-mediamtx.ps1)
mediamtx.exe
mediamtx.zip
*.log
# Runtime config generated by scripts/start-mediamtx.ps1 from
# mediamtx.yml - contains this machine's LAN IP, never commit it.
mediamtx.local.yml
# Auto-generated TLS material (MediaMTX creates auto.crt/auto.key
# for the servers that need them) - never commit these.
*.crt
*.key
