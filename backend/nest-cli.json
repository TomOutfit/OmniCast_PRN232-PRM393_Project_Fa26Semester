{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "../protos/*.proto",
        "outDir": "dist/"
      }
    ],
    "webpack": true,
    "tsConfigPath": "tsconfig.build.json"
  },
  "entryFile": "main"
}
