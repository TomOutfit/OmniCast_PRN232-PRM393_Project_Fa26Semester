// ============================================================
// OmniCast - Audit Logger (gRPC microservice) package.json
// ============================================================
//
// Standalone NestJS microservice that writes immutable audit trails
// via gRPC. The HTTP API at `backend/src/main.ts` can call into
// this when `AUDIT_LOGGER_GRPC_URL` env is set (fail-open: HTTP API
// keeps writing through Prisma even if gRPC is unreachable).
//
// Local dev:  `pnpm dev`  → ts-node-dev
// Test:       `pnpm test`  → vitest
// Container:  `pnpm build && docker build .`
//
// The `.proto` file is **copied** from `backend/protos/audit_logger.proto`
// at build time (script: `proto:sync`) — keeping a single source of
// truth in the mono-repo.
// ============================================================
{
  "name": "@omnicast/audit-logger",
  "version": "1.0.0",
  "description": "OmniCast audit-logger gRPC microservice",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "proto:sync": "node scripts/sync-proto.js",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.10.7",
    "@grpc/proto-loader": "^0.7.10",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/microservices": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@prisma/client": "^5.18.0",
    "helmet": "^7.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
