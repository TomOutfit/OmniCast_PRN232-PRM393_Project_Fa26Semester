# ============================================================
// OmniCast - Audit Logger gRPC Microservice
// ============================================================
//
// Standalone gRPC service for high-throughput audit logging.
// The HTTP API (`backend/`) optionally forwards events to this
// service via `AUDIT_LOGGER_GRPC_URL`.
//
// Local:
//   pnpm install
//   cp .env.example .env
//   pnpm start:dev
//
// Docker:
//   docker compose up
//
// Deploy: see `render.yaml` for Render.com (same format works
// on Railway).
// ============================================================

PORT=3100
AUDIT_LOGGER_GRPC_URL=0.0.0.0:50051
AUDIT_LOGGER_HTTP_PORT=3100

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/omnicast
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/omnicast

NODE_ENV=development
LOG_LEVEL=log
