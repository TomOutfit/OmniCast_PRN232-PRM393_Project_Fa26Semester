# OmniCast Backend Environment Variables
# ====================================

# Database - Supabase PostgreSQL
# Replace [YOUR-PASSWORD] with your actual Supabase password
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.tktexqtqfnlfynbytjpw.supabase.co:5432/postgres"

# Supabase (for client-side if needed)
NEXT_PUBLIC_SUPABASE_URL="https://tktexqtqfnlfynbytjpw.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_sZa2lJxnHmCn4DsesvFl2g_pU6Q7FQy"

# JWT Secret - Generate a secure random string
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="60m"
JWT_REFRESH_EXPIRES_IN="7d"

# Encryption (for passwords - using bcrypt)
BCRYPT_ROUNDS=12

# Server
PORT=3000
NODE_ENV=development

# CORS
# NOTE: `main.ts` reads FRONTEND_URL (CORS_ORIGIN above is kept only for
# backwards compatibility with older tooling).
#
# You do NOT need to list your LAN IP here: ANY literal IPv4 origin
# (http://192.168.1.204:3001, http://172.9.8.239:3001, ...) is
# accepted automatically, because the frontend routes to the local
# backend on exactly those addresses. Add an entry only when you
# serve the frontend from a PUBLIC hostname that is not a
# *.vercel.app domain.
CORS_ORIGIN="http://localhost:3000,http://localhost:3001,https://omnicast.vercel.app"
FRONTEND_URL="http://localhost:3000,http://localhost:3001,https://omnicast.vercel.app,https://omnicast-fe.vercel.app"

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Storage (Supabase Storage bucket names)
STORAGE_BUCKET_VIDEOS="omnicast-videos"
STORAGE_BUCKET_IMAGES="omnicast-images"
STORAGE_BUCKET_AUDIO="omnicast-audio"

# Upload Root (legacy self-record storage, used by /programs/studio/recordings/upload/file)
UPLOAD_ROOT="uploads"
UPLOAD_PUBLIC_BASE_URL=""

# Cloudinary (Studio self-record flow, bypasses Vercel 4.5 MB body limit)
# Free tier: 25 GB storage + 25 GB bandwidth/month. Get credentials at
# https://console.cloudinary.com → API Keys (after sign-up).
#
# Two equivalent ways to configure — pick ONE:
#
#   (A) Single CLOUDINARY_URL (preferred for Heroku / Vercel / Render
#       because the dashboard exposes a single env field):
#           CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"
#
#   (B) Three separate vars (preferred for local .env):
#           CLOUDINARY_CLOUD_NAME=""
#           CLOUDINARY_API_KEY=""
#           CLOUDINARY_API_SECRET=""
#
# If both are present, CLOUDINARY_URL wins. NEVER commit a populated
# `.env` — keep secrets out of git. If you ever paste a real secret
# into chat, rotate it immediately from the Cloudinary dashboard.
CLOUDINARY_URL=""
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
CLOUDINARY_DEFAULT_FOLDER="omnicast-studio"

# External APIs
# ----------------------------------------------------------
# PayOS live checkout is deliberately disabled by default.
# Keep PAYOS_MODE=sandbox for local/mock payments (no real money).
# To accept real payments, set PAYOS_MODE=live and configure all keys,
# plus explicit HTTPS return/cancel URLs. Never put these credentials in frontend env.
# Apply backend/prisma/migrations before deploying code that uses PayOS fields.
# Register the webhook URL in the PayOS dashboard: /api/v1/billing/payos/webhook
PAYOS_MODE=sandbox
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=
PAYOS_CANCEL_URL=
# OpenAI — BẮT BUỘC với production. AI Curator pipeline sẽ dùng
# GPT-4o thật khi key hợp lệ; nếu trống hoặc bằng "dummy-key" service
# sẽ tự fallback về `heuristic-fallback-v1`. Lấy key tại:
# https://platform.openai.com/api-keys
OPENAI_API_KEY=""
# ----------------------------------------------------------
# TMDB (chỉ dùng cho enrichment metadata phim truyền hình)
TMDB_API_KEY=""

# YouTube Data API v3 (optional - for live stream schedule ingest)
# Get key at https://console.cloud.google.com/apis/credentials
# Enable "YouTube Data API v3" in your Google Cloud project
YOUTUBE_API_KEY=""

# Twitch Helix API (optional - for Twitch schedule ingest)
# Register at https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""

# MediaMTX / Streaming Server (Local Development)
# ----------------------------------------------------------
# Two ways to run MediaMTX (both share `backend/mediamtx/mediamtx.yml`):
#   (A) Windows binary — `backend\scripts\start-mediamtx.ps1`
#       (downloads mediamtx.exe automatically, no Docker needed)
#   (B) Docker — `docker-compose -f docker-compose.yml up -d`
#
# Leave these values empty for local development on the same LAN.
# The backend detects the current LAN IP, but it is not reachable by
# viewers outside the local network.
#
# A hard-coded LAN IP goes stale as soon as the DHCP lease renews and
# every viewer then gets a dead stream. A `MEDIAMTX_PUBLIC_HOST` that
# is no longer an address of this machine is ignored automatically,
# and a `MEDIAMTX_*_URL` that points at a different IP is ignored
# too — so a leftover value can never win over the detected one.
#
# The start script auto-detects and prints the right values, and
# `-SyncEnv` writes them into `backend/.env` if you want them pinned.
MEDIAMTX_PUBLIC_HOST=
MEDIAMTX_BIND_ADDRESS=0.0.0.0
# Public deployment: set this to a public HTTPS reverse proxy that
# routes HLS to MediaMTX :8888 and WHIP to :8889. Set
# MEDIAMTX_PUBLIC_HOST to the DNS name advertised for WebRTC ICE, and
# route UDP 8189 to MediaMTX. Add a TURN relay for networks that block ICE.
# A quick HLS-only tunnel does not support remote camera publishing.
# With Docker and public DNS, start the bundled Caddy proxy using:
#   docker compose --profile public up -d
MEDIAMTX_PUBLIC_BASE_URL=
MEDIAMTX_HLS_URL=
MEDIAMTX_WEBRTC_URL=
MEDIAMTX_WHIP_URL=
MEDIAMTX_RTMP_URL=
# Override when MediaMTX cannot reach the backend on the local Docker host.
# Example: https://omnicast-api.vercel.app/api/v1/programs/studio/media-auth
MEDIAMTX_AUTH_URL=
# Optional global TURN relay for restrictive NATs. Create a Cloudflare
# Realtime TURN key and API token; the API token stays on the backend.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# MediaMTX restricts the `api` action to loopback IPs by default,
# so the API is only reachable from this machine.
MEDIAMTX_API_URL=http://127.0.0.1:9997

# LAN access & the Windows Firewall
# ----------------------------------------------------------
# The dev stack listens on TCP 3000 (backend), 3001 (frontend),
# 8888 (HLS), 8889 (WHIP/WHEP), 1935 (RTMP) and UDP 8189
# (WebRTC ICE). Windows blocks inbound connections on every network
# PROFILE that has no matching rule, so a setup that works on the
# office Wi-Fi (Public) silently fails on a home router (Private).
#
# Run this ONCE as administrator to open the ports for ALL profiles:
#
#   powershell -ExecutionPolicy Bypass -File backend\scripts\open-lan-ports.ps1
#
# The script elevates itself, is idempotent, and can be undone with
# `-Remove`. Preview the rule set without changing anything using
# `-DryRun`.

# Production MediaMTX (when deployed)
# MEDIAMTX_PUBLIC_HOST=stream.your-domain.com
# MEDIAMTX_PUBLIC_BASE_URL=https://stream.your-domain.com
# For split domains, set the HLS and WHIP URLs separately.
# MEDIAMTX_RTMP_URL=rtmp://stream.your-domain.com:1935
# MEDIAMTX_HLS_URL=https://stream.your-domain.com
# MEDIAMTX_WEBRTC_URL=wss://stream.your-domain.com
# MEDIAMTX_WHIP_URL=https://stream.your-domain.com

# Ingest Worker Cron Settings (optional - defaults shown)
INGEST_YOUTUBE_CRON="0 */15 * * * *"
INGEST_TWITCH_CRON="0 */30 * * * *"
INGEST_TMDB_AUTO_ENRICH="true"
