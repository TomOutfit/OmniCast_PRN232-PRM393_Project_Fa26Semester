generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "postgresqlExtensions"]
  binaryTargets   = ["native", "rhel-openssl-3.0.x", "rhel-openssl-1.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [uuid_ossp(map: "uuid-ossp", schema: "extensions")]
}

model User {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email         String    @unique @db.VarChar(255)
  passwordHash  String    @db.VarChar(255)
  fullName      String    @db.VarChar(255)
  avatarUrl     String?   @db.VarChar(500)
  bio           String?   @db.VarChar(500)
  role          UserRole? @default(VIEWER)
  isActive      Boolean?  @default(true)
  emailVerified Boolean?  @default(false)
  lastLoginAt   DateTime? @db.Timestamp(6)
  createdAt     DateTime? @default(now()) @db.Timestamp(6)
  updatedAt     DateTime? @default(now()) @updatedAt @db.Timestamp(6)

  // ── Back-relations (see `001_init.sql` FK constraints) ───────────
  ownedChannels     LiveChannel[]    @relation("ChannelOwner")
  refreshTokens     RefreshToken[]
  follows           Follow[]         @relation("FollowFollower")
  comments          Comment[]        @relation("CommentAuthor")
  commentLikes      CommentLike[]    @relation("CommentLikeUser")
  reactions         Reaction[]       @relation("ReactionUser")
  watchHistory      WatchHistory[]
  notifications     Notification[]   @relation("NotificationRecipient")
  actorNotifications Notification[]  @relation("NotificationActor")

  @@index([email], map: "idx_user_email")
  @@index([role], map: "idx_user_role")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  token     String    @unique @db.VarChar(500)
  userId    String?   @db.Uuid
  expiresAt DateTime  @db.Timestamp(6)
  createdAt DateTime? @default(now()) @db.Timestamp(6)
  isRevoked Boolean?  @default(false)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expiresAt], map: "idx_refresh_token_expires")
  @@index([userId], map: "idx_refresh_token_user")
}

model ProductionTag {
  id    String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name  String  @unique @db.VarChar(100)
  slug  String  @unique @db.VarChar(100)
  color String? @db.VarChar(20)
  type  TagType

  @@index([type], map: "idx_production_tag_type")
}

model LiveChannel {
  id                  String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name                String       @db.VarChar(255)
  slug                String       @unique @db.VarChar(255)
  description         String?      @db.VarChar(1500)
  logoUrl             String?      @db.VarChar(500)
  badgeUrl            String?      @db.VarChar(500)
  avatarUrl           String?      @db.VarChar(500)
  coverUrl            String?      @db.VarChar(500)
  bannerColor         String?      @db.VarChar(20)
  tagline             String?      @db.VarChar(200)
  category            LiveCategory
  subcategory         String?      @db.VarChar(100)
  language            String?      @default("vi") @db.VarChar(10)
  region              String?      @db.VarChar(100)
  followerCount       Int?         @default(0)
  totalViews          BigInt?      @default(0)
  totalVideos         Int?         @default(0)
  subscriberCount     Int?         @default(0)
  isVerified          Boolean?     @default(false)
  isActive            Boolean?     @default(true)
  isFeatured          Boolean?     @default(false)
  ownerId             String?      @db.Uuid
  isPublic            Boolean?     @default(true)
  allowComments       Boolean?     @default(true)
  requireSub          Boolean?     @default(false)
  createdAt           DateTime?    @default(now()) @db.Timestamp(6)
  updatedAt           DateTime?    @default(now()) @updatedAt @db.Timestamp(6)
  twitchBroadcasterId String?      @db.VarChar(100)
  youtubeChannelId    String?      @db.VarChar(100)

  // ── Relations (see `001_init.sql` FK constraints) ───────────────
  owner        User?       @relation("ChannelOwner", fields: [ownerId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  liveEvents   LiveEvent[] @relation("LiveEventChannel")
  recordings   Recording[] @relation("RecordingChannel")
  podcasts     Podcast[]   @relation("PodcastChannel")
  followers    Follow[]    @relation("FollowChannel")

  @@index([category], map: "idx_live_channel_category")
  @@index([isFeatured, followerCount], map: "idx_live_channel_featured")
  @@index([ownerId], map: "idx_live_channel_owner")
  @@index([slug], map: "idx_live_channel_slug")
  @@index([twitchBroadcasterId], map: "idx_live_channel_twitch")
  @@index([youtubeChannelId], map: "idx_live_channel_youtube")
}

model LiveEvent {
  id               String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title            String            @db.VarChar(255)
  description      String?           @db.VarChar(3000)
  thumbnailUrl     String?           @db.VarChar(500)
  streamSource     ContentSource?    @default(EXTERNAL)
  externalPlatform ExternalPlatform?
  externalId       String?           @db.VarChar(255)
  externalUrl      String?           @db.VarChar(500)
  embedCode        String?
  streamUrl        String?           @db.VarChar(500)
  streamKey        String?           @db.VarChar(255)
  isPrivate        Boolean?          @default(false)
  streamPassword   String?           @db.VarChar(255)
  quality          StreamQuality?    @default(AUTO)
  language         String?           @default("vi") @db.VarChar(10)
  status           EventStatus?      @default(SCHEDULED)
  scheduledAt      DateTime          @db.Timestamp(6)
  startedAt        DateTime?         @db.Timestamp(6)
  endedAt          DateTime?         @db.Timestamp(6)
  /// Estimated length in **seconds** (written by ingest pipelines). Internal services normalise this to minutes via `normalizeDurationMinutes`.
  duration         Int?
  viewerCount      Int?              @default(0)
  peakViewers      Int?              @default(0)
  likeCount        Int?              @default(0)
  commentCount     Int?              @default(0)
  shareCount       Int?              @default(0)
  channelId        String?           @db.Uuid
  tags             String[]
  autoRecord       Boolean?          @default(true)
  slowMode         Boolean?          @default(false)
  chatEnabled      Boolean?          @default(true)
  createdAt        DateTime?         @default(now()) @db.Timestamp(6)
  updatedAt        DateTime?         @default(now()) @updatedAt @db.Timestamp(6)
  curatorReports   AiCuratorReport[]
  reactions        Reaction[]
  watchlistItems   Watchlist[]

  // ── Relation back to LiveChannel (see `001_init.sql:142`) ────────
  channel LiveChannel? @relation("LiveEventChannel", fields: [channelId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([channelId, externalPlatform, externalId], map: "uq_live_event_channel_platform_external")
  @@index([channelId, status], map: "idx_live_event_channel_status")
  @@index([status, scheduledAt], map: "idx_live_event_status_scheduled")
  @@index([status, startedAt], map: "idx_live_event_status_started")
}

model Recording {
  id                   String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title                String            @db.VarChar(255)
  description          String?           @db.VarChar(3000)
  thumbnailUrl         String?           @db.VarChar(500)
  contentSource        ContentSource?    @default(EXTERNAL)
  externalPlatform     ExternalPlatform?
  externalId           String?           @db.VarChar(255)
  externalUrl          String?           @db.VarChar(500)
  embedCode            String?
  videoUrl             String?           @db.VarChar(500)
  videoBucketPath      String?           @db.VarChar(500)
  fileSize             BigInt?
  generatedFromEventId String?           @unique @db.Uuid
  duration             Int
  quality              StreamQuality?    @default(HD_720P)
  language             String?           @default("vi") @db.VarChar(10)
  audioUrl             String?           @db.VarChar(500)
  audioBucketPath      String?           @db.VarChar(500)
  viewCount            BigInt?           @default(0)
  likeCount            Int?              @default(0)
  commentCount         Int?              @default(0)
  shareCount           Int?              @default(0)
  downloadCount        Int?              @default(0)
  contentType          ContentType?      @default(VIDEO)
  channelId            String?           @db.Uuid
  isPublished          Boolean?          @default(true)
  isFeatured           Boolean?          @default(false)
  isAgeRestricted      Boolean?          @default(false)
  tags                 String[]
  category             LiveCategory?
  chapters             Json?
  subtitles            Json?
  createdAt            DateTime?         @default(now()) @db.Timestamp(6)
  updatedAt            DateTime?         @default(now()) @updatedAt @db.Timestamp(6)
  publishedAt          DateTime?         @default(now()) @db.Timestamp(6)
  sourceType           StreamSourceType?
  license              ContentLicense    @default(UNKNOWN)
  sourceAttribution    String?           @db.VarChar(500)
  fallbackUrl          String?           @db.VarChar(500)
  thumbnailAttribution String?           @db.VarChar(500)
  isActive             Boolean           @default(true)
  lastCheckedAt        DateTime?
  lastStatus           String?           @db.VarChar(20)

  // ── Relation back to LiveChannel (see `001_init.sql:180`) ────────
  channel  LiveChannel? @relation("RecordingChannel", fields: [channelId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  comments Comment[]    @relation("CommentRecording")
  reactions Reaction[]  @relation("ReactionRecording")
  watchHistory WatchHistory[]

  @@index([isActive, lastCheckedAt])
  @@index([license])
  @@index([sourceType])
  @@index([channelId], map: "idx_recording_channel")
  @@index([contentSource], map: "idx_recording_content_source")
  @@index([contentType], map: "idx_recording_content_type")
  @@index([isFeatured, publishedAt], map: "idx_recording_featured")
  @@index([viewCount], map: "idx_recording_view_count")
}

model Podcast {
  id            String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title         String        @db.VarChar(255)
  slug          String        @unique @db.VarChar(255)
  description   String?       @db.VarChar(2000)
  coverUrl      String?       @db.VarChar(500)
  category      LiveCategory? @default(PODCAST)
  tags          String[]
  channelId     String?       @db.Uuid
  totalEpisodes Int?          @default(0)
  totalListens  BigInt?       @default(0)
  isExplicit    Boolean?      @default(false)
  createdAt     DateTime?     @default(now()) @db.Timestamp(6)
  updatedAt     DateTime?     @default(now()) @updatedAt @db.Timestamp(6)

  // ── Relation back to LiveChannel (see `001_init.sql:211`) ────────
  channel LiveChannel? @relation("PodcastChannel", fields: [channelId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  episodes PodcastEpisode[]

  @@index([channelId], map: "idx_podcast_channel")
}

model PodcastEpisode {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title         String    @db.VarChar(255)
  description   String?   @db.VarChar(2000)
  episodeNumber Int?
  seasonNumber  Int?      @default(1)
  duration      Int
  audioUrl      String    @db.VarChar(500)
  coverUrl      String?   @db.VarChar(500)
  listenCount   BigInt?   @default(0)
  podcastId     String?   @db.Uuid
  publishedAt   DateTime? @default(now()) @db.Timestamp(6)
  createdAt     DateTime? @default(now()) @db.Timestamp(6)

  podcast Podcast? @relation(fields: [podcastId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([podcastId], map: "idx_podcast_episode_podcast")
}

model Follow {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  followerId String?   @db.Uuid
  channelId  String?   @db.Uuid
  createdAt  DateTime? @default(now()) @db.Timestamp(6)

  // ── Relations (see `001_init.sql:244-245`) ──────────────────────
  follower User?       @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  channel  LiveChannel? @relation("FollowChannel", fields: [channelId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([followerId, channelId])
  @@index([channelId], map: "idx_follow_channel")
  @@index([followerId], map: "idx_follow_follower")
}

model Comment {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  content     String    @db.VarChar(1000)
  userId      String?   @db.Uuid
  recordingId String?   @db.Uuid
  parentId    String?   @db.Uuid
  likeCount   Int?      @default(0)
  isPinned    Boolean?  @default(false)
  isEdited    Boolean?  @default(false)
  createdAt   DateTime? @default(now()) @db.Timestamp(6)
  updatedAt   DateTime? @default(now()) @updatedAt @db.Timestamp(6)

  // ── Relations (see `001_init.sql:256-258`) ──────────────────────
  user      User?      @relation("CommentAuthor", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  recording Recording? @relation("CommentRecording", fields: [recordingId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  parent    Comment?   @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  replies   Comment[]  @relation("CommentReplies")
  likes     CommentLike[]

  @@index([parentId], map: "idx_comment_parent")
  @@index([recordingId], map: "idx_comment_recording")
}

model CommentLike {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String?   @db.Uuid
  commentId String?   @db.Uuid
  createdAt DateTime? @default(now()) @db.Timestamp(6)

  user    User?    @relation("CommentLikeUser", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, commentId])
}

model Reaction {
  id          String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId      String?      @db.Uuid
  type        ReactionType
  recordingId String?      @db.Uuid
  createdAt   DateTime?    @default(now()) @db.Timestamp(6)
  liveEventId String?      @db.Uuid

  // ── Relations (see `001_init.sql:280-282`, `003_live_event_reactions.sql`) ──
  user      User?      @relation("ReactionUser", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  recording Recording? @relation("ReactionRecording", fields: [recordingId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  liveEvent LiveEvent? @relation(fields: [liveEventId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, liveEventId, type], map: "Reaction_user_live_event_type_unique")
  @@unique([userId, recordingId, type], map: "Reaction_user_recording_type_unique")
  @@index([liveEventId])
  @@index([recordingId], map: "idx_reaction_recording")
}

model WatchHistory {
  id               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId           String?   @db.Uuid
  recordingId      String?   @db.Uuid
  progressSeconds  Int?      @default(0)
  completedPercent Int?      @default(0)
  isCompleted      Boolean?  @default(false)
  lastWatchedAt    DateTime? @default(now()) @db.Timestamp(6)
  createdAt        DateTime? @default(now()) @db.Timestamp(6)

  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  recording Recording? @relation(fields: [recordingId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, recordingId])
  @@index([userId, lastWatchedAt], map: "idx_watch_history_user")
}

model Notification {
  id          String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId      String?          @db.Uuid
  type        NotificationType
  title       String           @db.VarChar(255)
  message     String?          @db.VarChar(500)
  actionUrl   String?          @db.VarChar(500)
  actorId     String?          @db.Uuid
  eventId     String?          @db.Uuid
  recordingId String?          @db.Uuid
  channelId   String?          @db.Uuid
  isRead      Boolean?         @default(false)
  readAt      DateTime?        @db.Timestamp(6)
  createdAt   DateTime?        @default(now()) @db.Timestamp(6)

  // ── Relations (see `001_init.sql:305,310`) ──────────────────────
  user  User?  @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  actor User?  @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([userId, createdAt], map: "idx_notification_user_date")
  @@index([userId, isRead], map: "idx_notification_user_read")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  userEmail  String?  @db.VarChar(255)
  action     String   @db.VarChar(100)
  entityType String?  @db.VarChar(100)
  entityId   String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?  @db.VarChar(50)
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([action, createdAt], map: "idx_audit_action")
  @@index([entityType, entityId], map: "idx_audit_entity")
  @@index([userId, createdAt], map: "idx_audit_user")
}

model Watchlist {
  id        String    @id @default(dbgenerated("gen_random_uuid()"))
  userId    String
  programId String    @db.Uuid
  channelId String?   @db.Uuid
  note      String?   @db.VarChar(500)
  addedAt   DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  program   LiveEvent @relation(fields: [programId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, programId])
  @@index([userId, addedAt])
  @@index([programId])
}

model AiCuratorReport {
  id                   String    @id @default(dbgenerated("gen_random_uuid()"))
  programId            String    @db.Uuid
  broadcastSuitability String    @db.VarChar(20)
  suggestedTimeSlot    String    @db.VarChar(100)
  targetAudienceVibe   String    @db.VarChar(500)
  riskWarnings         String    @db.VarChar(1000)
  sentimentAnalysis    Json
  complianceAssessment Json
  aiModelVersion       String    @db.VarChar(100)
  tokenUsed            Int?
  processingTimeMs     Int       @default(0)
  createdBy            String?
  createdAt            DateTime  @default(now())
  program              LiveEvent @relation(fields: [programId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([programId, createdAt])
  @@index([programId, createdAt])
}

enum UserRole {
  GUEST
  VIEWER
  STAFF
  ADMIN
}

enum LiveCategory {
  SPORTS
  SHOW
  ENTERTAINMENT
  CINE
  DRAMA
  NEWS
  MUSIC
  KIDS
  DOCUMENTARY
  GAMING
  TECH
  PODCAST
  EDUCATION
  LIFESTYLE
  FOOD
  TRAVEL
  ART
  BUSINESS
  HEALTH
}

enum ContentSource {
  EXTERNAL
  UPLOADED
  GENERATED
}

enum StreamSourceType {
  YOUTUBE_EMBED
  PEXELS
  ARCHIVE_ORG
  BLENDER_CC
  GOOGLE_SAMPLE
  W3_SAMPLE
  SAMPLELIB
  CLOUDINARY_DEMO
  MUX_TEST
  UNIFIED_TEST
  BUNNY_CDN
  UPLOADED_LOCAL
  TMDB_TRAILER
  YOUTUBE_DIRECT
  VIMEO
  TWITCH
}

enum ContentLicense {
  PEXELS_LICENSE
  CC0_PUBLIC_DOMAIN
  CC_BY_3
  CC_BY_4
  BLENDER_OPEN_MOVIE
  BUNNY_SELF_HOSTED
  DEMO_PRODUCTION_OK
  DEV_ONLY_TEST_FIXTURE
  UNKNOWN
}

enum ExternalPlatform {
  YOUTUBE
  VIMEO
  TWITCH
  FACEBOOK
  TIKTOK
  DAILYMOTION
  CUSTOM_HLS
  CUSTOM_RTMP
  CUSTOM_MP4
  EMBED_IFRAME
}

enum EventStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
  ON_DEMAND
}

enum ContentType {
  VIDEO
  AUDIO
  LIVE
}

enum StreamQuality {
  AUTO
  SD_480P
  HD_720P
  FULL_HD_1080P
  QHD_1440P
  UHD_4K
}

enum TagType {
  GENRE
  COUNTRY
  RATING
  FEATURE
}

enum ReactionType {
  HEART
  FIRE
  CLAP
  WOW
  SAD
  ANGRY
}

enum NotificationType {
  NEW_FOLLOWER
  NEW_VIDEO
  LIVE_START
  LIVE_ENDED
  COMMENT_REPLY
  COMMENT_MENTION
  REACTION
  SYSTEM_ANNOUNCEMENT
}

enum WatchSource {
  CHANNEL_PAGE
  SEARCH
  RECOMMENDATION
  DIRECT_LINK
  SOCIAL_SHARE
}
