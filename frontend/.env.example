# Environment Variables for OmniCast Frontend
# Copy this file to .env.local and fill in your values

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── LAN / multi-device note (LIVE WEBCAM) ─────────────────────
# To watch the live camera from another phone or PC, replace the
# values above with the LAN IP of the machine running the backend,
# e.g. NEXT_PUBLIC_API_URL=http://192.168.2.74:3000/api/v1
# and NEXT_PUBLIC_APP_URL=http://192.168.2.74:3001
#
# `frontend/lib/api.ts` silently falls back to the deployed API
# (omnicast-api.vercel.app) for non-localhost hostnames, so without
# this the other devices would talk to production and never see the
# local LiveEvent. See `.env.local` for the full walkthrough.

# Authentication (NextAuth.js)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-generate-with-openssl-rand-base64-32

# Feature Flags
NEXT_PUBLIC_ENABLE_AI_CURATOR=true
NEXT_PUBLIC_LIVE_CHAT_ENABLED=true

# Analytics (Optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_POSTHOG_KEY=
