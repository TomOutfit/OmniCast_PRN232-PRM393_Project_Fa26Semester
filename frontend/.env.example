# Environment Variables for OmniCast Frontend
# Copy this file to .env.local and fill in your values

# API Configuration
#
# IMPORTANT: do NOT hard-code your LAN IP here.
# `frontend/lib/api.ts` derives the API host from `window.location.hostname`
# whenever the browser runs on a literal IPv4 / localhost address, so any
# device on the LAN automatically talks to the backend on its own host.
# A baked IP goes stale as soon as the DHCP lease changes and breaks the
# whole app — leave it as localhost for local development.
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── LAN / multi-device note (LIVE WEBCAM) ─────────────────────
# To watch the live camera from another phone or PC, just open the
# frontend on that device using THIS machine's LAN address
# (e.g. http://192.168.2.74:3001). The API host is resolved
# automatically from the browser hostname, so no configuration is
# needed on the second device.
#
# `backend\.env` must expose the same host to the frontend (CORS) —
# see FRONTEND_URL / MEDIAMTX_PUBLIC_HOST there.

# Authentication (NextAuth.js)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-generate-with-openssl-rand-base64-32

# Feature Flags
NEXT_PUBLIC_ENABLE_AI_CURATOR=true
NEXT_PUBLIC_LIVE_CHAT_ENABLED=true

# Analytics (Optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_POSTHOG_KEY=
